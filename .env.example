# Supabase Configuration
# Get these values from your Supabase project dashboard: https://supabase.com/dashboard
# Go to Settings > API to find these values

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Vapi Voice Agent Configuration
# Get your API keys from: https://vapi.ai
# Public key for client-side usage
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your_vapi_public_key
# Assistant ID (Recommended to prevent 403 Forbidden errors)
NEXT_PUBLIC_VAPI_ASSISTANT_ID=your_assistant_id
# Private key for server-side operations (keep secret!)
VAPI_PRIVATE_KEY=your_vapi_private_key

# OpenAI Configuration (optional, for additional AI features)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Google Gemini API Key
GEMINI_API_KEY=
